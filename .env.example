# ============================================================
# AI-Powered Career Intelligence Platform — Environment Configuration
# ============================================================

# LLM Provider Configuration
# Supported providers: "mock", "openai", "gemini", "ollama", "custom"
LLM_PROVIDER=mock

# Model Name (e.g. gpt-4o, gemini-1.5-flash, llama3)
LLM_MODEL=gpt-4o-mini

# API Credentials (Do NOT commit actual keys)
LLM_API_KEY=your_llm_api_key_here

# API Endpoint URL (optional override for custom/proxy endpoints)
LLM_API_BASE=https://api.openai.com/v1

# Max Tokens & Context Configuration
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2

# Long Transcript Chunking Configuration
MAX_CHUNK_TOKENS=3000
CHUNK_OVERLAP_TOKENS=200

# Database Configuration
DATABASE_PATH=career_intelligence.db
